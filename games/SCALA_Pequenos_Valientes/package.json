{
  "name": "scala-pequenos-valientes",
  "version": "1.1.0",
  "description": "Aventura educativa cristiana infantil para expresar sentimientos, poner límites y pedir ayuda",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "check": "tsc --noEmit && eslint",
    "build": "tsc && vite build && node scripts/build_offline.mjs",
    "test": "node --experimental-strip-types scripts/test_learning.mjs",
    "test:ui": "node scripts/test_ui.mjs",
    "store:prepare": "node scripts/prepare_store.mjs",
    "android:build": "bash scripts/build_android.sh",
    "cap:sync": "npm run build && cap sync android"
  },
  "keywords": [],
  "author": "SCALA",
  "license": "UNLICENSED",
  "devDependencies": {
    "@capacitor/cli": "8.4.3",
    "@eslint/css": "^0.14.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.5.0",
    "eslint": "^10.1.0",
    "globals": "^17.4.0",
    "playwright": "^1.58.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "@capacitor/android": "8.4.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.4.3",
    "@capacitor/preferences": "^8.0.1"
  }
}
