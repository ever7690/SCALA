{
  "name": "scala-palabras-de-fe",
  "version": "1.1.3",
  "description": "Juego bíblico SCALA: 1000 crucigramas en español, audio y progreso sin conexión",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "check": "tsc --noEmit && eslint",
    "build": "tsc && node scripts/build_privacy.mjs && vite build && node scripts/build_offline.mjs",
    "test": "node scripts/validate_game.mjs",
    "test:ui": "node scripts/test_ui.mjs",
    "store:prepare": "node scripts/prepare_store.mjs",
    "cap:sync": "npm run build && cap sync android",
    "android:build": "bash scripts/build_android.sh",
    "android:open": "cap open android",
    "levels:build": "uv run --no-project --python /usr/bin/python3 scripts/generate_scala_levels.py"
  },
  "keywords": [],
  "author": "SCALA",
  "license": "MIT",
  "devDependencies": {
    "@capacitor/cli": "8.4.3",
    "@eslint/css": "^0.14.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.5.0",
    "eslint": "^10.1.0",
    "globals": "^17.4.0",
    "playwright": "^1.58.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "@capacitor/android": "8.4.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.4.3",
    "@capacitor/preferences": "^8.0.1"
  }
}
